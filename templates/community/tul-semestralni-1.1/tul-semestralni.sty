\newcommand{\tul@register}[5]{%
  \expandafter\def\csname tul@faculty@#1\endcsname{%
    \def\tul@asset{#2}\def\tul@name{#3}\definecolor{faculty}{HTML}{#4}\def\tul@address{#5}%
    \def\tul@web{www.#2.tul.cz}}}
\tul@register{FS}{fs}{Fakulta strojní}{888B95}{Studentská 1402/2, 461 17 Liberec 1}
\tul@register{FT}{ft}{Fakulta textilní}{924C14}{Studentská 1402/2, 461 17 Liberec 1}
\tul@register{FP}{fp}{Fakulta přírodovědně-humanitní a pedagogická}{0076D5}{Univerzitní náměstí 1410/1, 461 17 Liberec 1}
\tul@register{EF}{ef}{Ekonomická fakulta}{65A812}{Voroněžská 1329/13, 460 02 Liberec 2}
\tul@register{FUA}{fua}{Fakulta umění a architektury}{006443}{Studentská 1402/2, 461 17 Liberec 1}
\tul@register{FM}{fm}{Fakulta mechatroniky, informatiky a mezioborových studií}{EA7603}{Studentská 1402/2, 461 17 Liberec 1}
\tul@register{FZS}{fzs}{Fakulta zdravotnických studií}{00B0BE}{Studentská 1402/2, 461 17 Liberec 1}
\newcommand{\Fakulta}[1]{%
  \@ifundefined{tul@faculty@#1}{\PackageError{tul-semestralni}{Neznama fakulta #1}{Pouzij FS, FT, FP, EF, FUA, FM nebo FZS.}}{\csname tul@faculty@#1\endcsname}}
\Fakulta{FS}
